# Copy to .env and fill in.

# Token returned by @BotFather.
BOT_TOKEN=1234567890:replace-me

# Full public URL (with scheme) of the outer reverse proxy terminating TLS
# in front of Anubis (127.0.0.1:8923).
PUBLIC_URL=https://bot.example.com

# Optional: tune log level. Default is info.
# RUST_LOG=anubot=debug,info
